# Copiez ce fichier en ".env" (même dossier que server.js) puis adaptez-le.
# Sans fichier .env, l'application fonctionne en mode SIMULATION (aucun e-mail réellement envoyé).

# --- Option 1 : Gmail (vrais e-mails) ---------------------------------------
# 1) Activez la validation en 2 étapes sur votre compte Google
# 2) Créez un "mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3) Collez-le ci-dessous (16 caractères, sans espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot_de_passe_application
MAIL_FROM="Gestion des Déplacements <votre.adresse@gmail.com>"

# --- Option 2 : Ethereal (boîte de test, rien n'est livré, aperçu par lien) ---
# MAIL_MODE=ethereal

# --- Option 3 : simulation (aucun envoi) ---
# MAIL_MODE=simulation

# Autres réglages possibles : PORT=3000

# --- Tâches automatiques (valeurs par défaut ci-dessous) ---------------------
# RAPPEL_HEURES_AVANT=24      rappel envoyé à l'agent X heures avant le départ d'une mission validée
# RELANCE_HEURES=48           relance du responsable si la demande reste "En attente" depuis X heures
# ESCALADE_HEURES=72          escalade à l'administrateur après X heures
# TACHES_INTERVALLE_MIN=30    fréquence de vérification (minutes)
# TACHES_AUTO=false           pour désactiver les tâches automatiques
# APP_URL=http://localhost:3000   adresse mise dans le bouton des e-mails de relance
# Pour une DÉMO immédiate : RELANCE_HEURES=0 et ESCALADE_HEURES=0 (puis bouton "Exécuter maintenant", 2 fois)
